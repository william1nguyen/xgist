{
	"include": ["**/*.ts", "**/*.tsx", ".react-router/types/**/*"],
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": ["vite/client"],
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"rootDirs": [".", "./.react-router/types"],
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		},
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"strict": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"skipLibCheck": true
	}
}
