DATABASE_URL=postgres://conductor:conductor@localhost:5432/workflow?sslmode=disable
KAFKA_BROKERS=localhost:9092

CONDUCTOR_HTTP_ADDR=:8085

# conductor is a Kafka-only service (no gRPC server of its own) but calls
# media.GetMedia and billing.GetQuote as a gRPC client — see
# docs/services/conductor.md.
CONDUCTOR_MEDIA_GRPC_ADDR=localhost:19095
CONDUCTOR_BILLING_GRPC_ADDR=localhost:9093

CONDUCTOR_MAX_STEP_ATTEMPTS=3
CONDUCTOR_SCHEDULER_INTERVAL=5s

CONDUCTOR_SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info
