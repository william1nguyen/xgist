DATABASE_URL=postgres://content:content@localhost:5432/content?sslmode=disable
KAFKA_BROKERS=localhost:9092

CONTENT_HTTP_ADDR=:8084
CONTENT_GRPC_ADDR=:9095

# Optional: presigns summary-audio playback URLs. Empty MINIO_ENDPOINT
# disables this — GetContent still works, just without a url on
# SummaryAudio. Same bucket media writes derivatives to (see
# services/media/.env.example) since worker uploads summary audio there.
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_MEDIA_BUCKET=media

CONTENT_SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info
